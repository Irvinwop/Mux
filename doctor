#!/usr/bin/env bash
set -u

failures=0
warnings=0

ok() {
  printf 'ok    %s\n' "$1"
}

warn() {
  printf 'WARN  %s\n' "$1" >&2
  printf '      %s\n' "$2" >&2
  warnings=$((warnings + 1))
}

fail() {
  printf 'FAIL  %s\n' "$1" >&2
  printf '      Fix: %s\n' "$2" >&2
  failures=$((failures + 1))
}

command_fix() {
  case "$1" in
    cc)
      printf '%s' 'install a C17 compiler (Arch: base-devel)'
      ;;
    kitty|kitten)
      printf '%s' 'install Kitty 0.45 or newer, including its kitten helper (Arch: kitty)'
      ;;
    meson)
      printf '%s' 'install Meson (Arch: meson)'
      ;;
    ninja)
      printf '%s' 'install Ninja (Arch: ninja)'
      ;;
    pkg-config)
      printf '%s' 'install pkg-config (Arch: pkgconf)'
      ;;
    sha256sum|stat)
      printf '%s' 'install GNU coreutils (Arch: coreutils)'
      ;;
  esac
}

check_kitty_version() {
  local output major minor patch version

  if ! output="$(LC_ALL=C kitty --version 2>/dev/null)"; then
    fail 'Kitty version could not be queried' 'install Kitty 0.45 or newer and ensure kitty --version works'
    return
  fi

  if [[ ! "$output" =~ ^kitty[[:space:]]+([0-9]+)\.([0-9]+)(\.([0-9]+))?([[:space:]].*)?$ ]]; then
    fail "Kitty version output is not understood: $output" 'install Kitty 0.45 or newer from an official distribution package'
    return
  fi

  major=$((10#${BASH_REMATCH[1]}))
  minor=$((10#${BASH_REMATCH[2]}))
  if [[ -n "${BASH_REMATCH[4]:-}" ]]; then
    patch=$((10#${BASH_REMATCH[4]}))
  else
    patch=0
  fi
  version="$major.$minor.$patch"

  if (( major > 0 || (major == 0 && minor >= 45) )); then
    ok "kitty $version (minimum 0.45)"
  else
    fail "kitty $version is older than required 0.45" 'upgrade Kitty to 0.45 or newer (Arch: pacman -Syu kitty)'
  fi
}

check_command() {
  local command="$1"
  if command -v "$command" >/dev/null 2>&1; then
    ok "$command: $(command -v "$command")"
  else
    fail "$command is missing" "$(command_fix "$command")"
  fi
}

package_fix() {
  case "$1" in
    glib-2.0|gio-2.0)
      printf '%s' "install GLib development files providing $1 (Arch: glib2)"
      ;;
    wpe-webkit-2.0|wpe-platform-2.0)
      printf '%s' "install WPE WebKit built with WPEPlatform enabled, providing $1 >= 2.52.5 (Arch: wpewebkit)"
      ;;
  esac
}

check_package() {
  local package="$1"
  local minimum="$2"
  local version

  if ! command -v pkg-config >/dev/null 2>&1; then
    return
  fi
  if ! pkg-config --exists "$package"; then
    fail "pkg-config package $package is missing" "$(package_fix "$package")"
    return
  fi

  version="$(pkg-config --modversion "$package" 2>/dev/null || printf unknown)"
  if pkg-config --atleast-version="$minimum" "$package"; then
    ok "$package $version"
  else
    fail "$package $version is older than required $minimum" "$(package_fix "$package")"
  fi
}

printf 'Mux v0.1 environment doctor\n'
printf '===========================\n'

if [[ "$(uname -s)" == Linux ]]; then
  ok 'operating system: Linux'
else
  fail 'operating system is not Linux' 'run Mux on Linux; the current WPEPlatform and IPC implementation is Linux-only'
fi

for command in cc kitty kitten meson ninja pkg-config sha256sum stat; do
  check_command "$command"
done

if command -v kitty >/dev/null 2>&1; then
  check_kitty_version
fi

check_package glib-2.0 2.74
check_package gio-2.0 2.74
check_package wpe-webkit-2.0 2.52.5
check_package wpe-platform-2.0 2.52.5

if [[ -d /dev/shm && -w /dev/shm ]]; then
  ok '/dev/shm is writable for raw frame transport'
else
  fail '/dev/shm is unavailable or not writable' 'mount a writable tmpfs at /dev/shm; containers may need --shm-size'
fi

if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  runtime_problem=''
  runtime_uid=''
  runtime_mode=''

  if [[ "$XDG_RUNTIME_DIR" != /* ]]; then
    runtime_problem='is not an absolute path'
  elif [[ -L "$XDG_RUNTIME_DIR" ]]; then
    runtime_problem='must not be a symlink'
  elif [[ ! -e "$XDG_RUNTIME_DIR" ]]; then
    runtime_problem='does not exist'
  elif [[ ! -d "$XDG_RUNTIME_DIR" ]]; then
    runtime_problem='is not a directory'
  elif ! runtime_uid="$(stat -c %u -- "$XDG_RUNTIME_DIR" 2>/dev/null)"; then
    runtime_problem='ownership could not be inspected'
  elif [[ "$runtime_uid" != "$EUID" ]]; then
    runtime_problem="is owned by uid $runtime_uid instead of effective uid $EUID"
  elif ! runtime_mode="$(stat -c %a -- "$XDG_RUNTIME_DIR" 2>/dev/null)"; then
    runtime_problem='permissions could not be inspected'
  elif [[ ! "$runtime_mode" =~ ^[0-7]{3,4}$ ]]; then
    runtime_problem="has an unrecognized mode: $runtime_mode"
  elif (( (8#$runtime_mode & 077) != 0 )); then
    runtime_problem="has group or other permission bits set (mode $runtime_mode)"
  elif [[ ! -w "$XDG_RUNTIME_DIR" || ! -x "$XDG_RUNTIME_DIR" ]]; then
    runtime_problem='is not writable and searchable by this user'
  fi

  if [[ -z "$runtime_problem" ]]; then
    ok "XDG_RUNTIME_DIR: $XDG_RUNTIME_DIR"
  else
    fail "XDG_RUNTIME_DIR $runtime_problem: $XDG_RUNTIME_DIR" 'repair the path so it is an existing owner-only directory, or unset it so Mux can use its owner-only /tmp fallback'
  fi
else
  ok "XDG_RUNTIME_DIR is unset; Mux will use /tmp/mux-$(id -u)"
fi

if [[ -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
  warn 'no Wayland or X11 display is visible in this shell' 'Builds and tests can run headlessly, but launching Kitty requires a graphical session.'
else
  ok 'graphical session is visible'
fi

if (( failures )); then
  printf '\n%d hard requirement(s) failed; Mux was not declared ready.\n' "$failures" >&2
  printf 'See docs/install.md for supported installation paths.\n' >&2
  exit 1
fi

printf '\nAll build requirements passed'
if (( warnings )); then
  printf ' with %d warning(s)' "$warnings"
fi
printf '. The ./mux launcher can build the WPE implementation incrementally.\n'
