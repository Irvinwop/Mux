chmod 600 "$CLIPBOARD_TELEMETRY"
FIXTURE_SERVER="$REPO_ROOT/scripts/runtime-smoke-browser-clipboard-fixture.py"
[[ -r $FIXTURE_SERVER ]] || fail "missing browser/clipboard fixture server: $FIXTURE_SERVER"

cp "$REPO_ROOT/kitty/kitty.conf" "$BASE/kitty/kitty.conf"
cp "$REPO_ROOT/kitty/wpe.conf" "$BASE/kitty/wpe.conf"
python3 - "$BASE/kitty/wpe.conf" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
old = 'remote_control_password "" detach-window focus-window launch\n'
new = 'remote_control_password "" detach-window focus-window launch send-key get-text send-text\n'
text = path.read_text(encoding="ascii")
if text.count(old) != 1:
    raise SystemExit("temporary Kitty ACL source did not match production config")
text = text.replace(old, new)
text += "\n# Preserve sanitizer diagnostics after a held smoke-test child exits.\n"
text += "scrollback_lines 100000\n"
text += "# Headless qualification cannot answer Kitty's clipboard prompt.\n"
text += "clipboard_control write-clipboard write-primary read-clipboard read-primary\n"
path.write_text(text, encoding="ascii")
PY

weston \
    --backend=headless \
    --fake-seat \
    --renderer=pixman \
    --shell=kiosk-shell.so \
    --width=1280 \
    --height=800 \
    --idle-time=0 \
    -S "$WAYLAND_DISPLAY" \
    --log="$LOG_DIR/weston.log" \
    >"$LOG_DIR/weston-stdio.log" 2>&1 &
WESTON_PID=$!
track_child "$WESTON_PID" weston
wait_socket "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" "$WESTON_PID" weston

PORT_FILE="$BASE/http.port"
python3 "$FIXTURE_SERVER" "$PORT_FILE" "$FIXTURE_STATE" \
    >"$LOG_DIR/http.log" 2>&1 &
HTTP_PID=$!
track_child "$HTTP_PID" http

for (( attempt=0; attempt < 200; attempt++ )); do
    [[ -s $PORT_FILE ]] && break
    pid_alive "$HTTP_PID" || fail "HTTP fixture server exited before publishing its port"
    sleep 0.05
done
[[ -s $PORT_FILE ]] || fail "HTTP fixture server did not publish its port"
HTTP_PORT=$(<"$PORT_FILE")
[[ $HTTP_PORT =~ ^[0-9]+$ ]] || fail "invalid fixture port: $HTTP_PORT"
BOOT_URL="http://127.0.0.1:$HTTP_PORT/index.html"
BAR_URL="http://127.0.0.1:$HTTP_PORT/bar.html"
SECOND_URL="http://127.0.0.1:$HTTP_PORT/second.html"
SAME_CLIPBOARD_URL="http://127.0.0.1:$HTTP_PORT/clipboard-same.html"
SAME_CLIPBOARD_TARGET_URL="http://127.0.0.1:$HTTP_PORT/clipboard-same-target.html"
CROSS_PANE_SOURCE_URL="http://127.0.0.1:$HTTP_PORT/clipboard-cross-pane-source.html"
CROSS_PANE_TARGET_URL="http://127.0.0.1:$HTTP_PORT/clipboard-cross-pane-target.html"
CROSS_PROFILE_SOURCE_URL="http://127.0.0.1:$HTTP_PORT/clipboard-cross-profile-source.html"
CROSS_PROFILE_TARGET_URL="http://127.0.0.1:$HTTP_PORT/clipboard-cross-profile-target.html"
PASSIVE_READ_URL="http://127.0.0.1:$HTTP_PORT/clipboard-passive-read.html"

python3 - \
    "$BOOT_URL" "$BAR_URL" "$SECOND_URL" "$SAME_CLIPBOARD_URL" \
    "$SAME_CLIPBOARD_TARGET_URL" \
    "$CROSS_PANE_SOURCE_URL" "$CROSS_PANE_TARGET_URL" \
    "$CROSS_PROFILE_SOURCE_URL" "$CROSS_PROFILE_TARGET_URL" \
    "$PASSIVE_READ_URL" <<'PY'
import sys
import urllib.request

for url in sys.argv[1:]:
    with urllib.request.urlopen(url, timeout=2) as response:
        if response.status != 200:
            raise SystemExit(f"fixture returned HTTP {response.status}: {url}")
PY

"$BIN_DIR/muxd" --foreground >"$LOG_DIR/muxd.log" 2>&1 &
MUXD_PID=$!
track_child "$MUXD_PID" muxd
wait_socket "$XDG_RUNTIME_DIR/mux/muxd.sock" "$MUXD_PID" muxd

initial_status=$(run_muxctl status) || fail "muxctl could not reach muxd"
[[ $initial_status =~ (^|[[:space:]])views=0($|[[:space:]]) ]] ||
    fail "muxd did not begin with zero views: $initial_status"

FRAME_ACK_TELEMETRY="$LOG_DIR/frame-acks.log"
: >"$FRAME_ACK_TELEMETRY"
chmod 600 "$FRAME_ACK_TELEMETRY"
MUX_SMOKE_FRAME_ACK_FILE="$FRAME_ACK_TELEMETRY" "$BIN_DIR/mux-engine" \
    --profile "$MUX_PROFILE" \
    --socket "$MUX_ENGINE_SOCKET" \
    >"$LOG_DIR/engine.log" 2>&1 &
ENGINE_PID=$!
track_child "$ENGINE_PID" mux-engine
wait_socket "$MUX_ENGINE_SOCKET" "$ENGINE_PID" mux-engine

KITTY_SOCKET="$XDG_RUNTIME_DIR/mux/kitty.sock"
KITTY_LISTEN_ON="unix:$KITTY_SOCKET"
export KITTY_LISTEN_ON

kitty \
    --config "$BASE/kitty/wpe.conf" \
    --listen-on "$KITTY_LISTEN_ON" \
    --title Mux \
    --hold \
    env \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        XDG_STATE_HOME="$XDG_STATE_HOME" \
        XDG_DATA_HOME="$XDG_DATA_HOME" \
        XDG_CACHE_HOME="$XDG_CACHE_HOME" \
        XDG_CONFIG_HOME="$XDG_CONFIG_HOME" \
        MUX_PROFILE="$MUX_PROFILE" \
        MUX_EPHEMERAL="$MUX_EPHEMERAL" \
        MUX_LAYER="$MUX_LAYER" \
        MUX_GLOBAL_BAR="$MUX_GLOBAL_BAR" \
        MUX_ENGINE_SOCKET="$MUX_ENGINE_SOCKET" \
        MUX_PROFILE_DATA_DIR="$MUX_PROFILE_DATA_DIR" \
        MUX_PROFILE_CACHE_DIR="$MUX_PROFILE_CACHE_DIR" \
        MUX_SMOKE_ID="$MUX_SMOKE_ID" \
        WPE_DISPLAY="$WPE_DISPLAY" \
        LIBGL_ALWAYS_SOFTWARE="$LIBGL_ALWAYS_SOFTWARE" \
        PATH="$PATH" \
        "$BIN_DIR/mux-layer" "$BOOT_URL" \
    >"$LOG_DIR/kitty.log" 2>&1 &
KITTY_PID=$!
track_child "$KITTY_PID" kitty
wait_socket "$KITTY_SOCKET" "$KITTY_PID" kitty

BOOT_VIEW_ID=$(wait_initial_view "$BOOT_URL" MUX_SMOKE_BOOT_LOADED)
SNAPSHOT=$(run_muxctl list)
BOOT_PANE_PID=$(marked_pid mux-pane) || fail "mux-pane process was not observed"
BAR_PID=$(marked_pid mux-bar) || fail "mux-bar process was not observed"
pid_alive "$BAR_PID" || fail "mux-bar exited"

reported_boot_pid=$(record_field "$SNAPSHOT" "$BOOT_VIEW_ID" pid)
BOOT_KITTY_ID=$(record_field "$SNAPSHOT" "$BOOT_VIEW_ID" kitty)
[[ $reported_boot_pid == "$BOOT_PANE_PID" ]] ||
    fail "muxctl pane PID $reported_boot_pid does not match process $BOOT_PANE_PID"
[[ -n $BOOT_KITTY_ID ]] || fail "muxctl did not report the initial Kitty window ID"
KITTY_WINDOW_IDS+=("$BOOT_KITTY_ID")
BAR_KITTY_ID=$(pid_env_value "$BAR_PID" KITTY_WINDOW_ID || true)
[[ -n $BAR_KITTY_ID ]] || fail "KITTY_WINDOW_ID was not present in the mux-bar environment"
[[ $BAR_KITTY_ID != "$BOOT_KITTY_ID" ]] ||
    fail "mux-bar and mux-pane unexpectedly reported the same Kitty window ID"

KITTY_PUBLIC_KEY_VALUE=$(pid_env_value "$BOOT_PANE_PID" KITTY_PUBLIC_KEY || true)
[[ -n $KITTY_PUBLIC_KEY_VALUE ]] ||
    fail "KITTY_PUBLIC_KEY was not present in the mux-pane environment"
wait_frame_ack "$BOOT_KITTY_ID" "$BOOT_URL" MUX_SMOKE_BOOT_LOADED

run_muxctl focus "$BOOT_VIEW_ID" >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl focus failed for $BOOT_VIEW_ID"
wait_active_view "$BOOT_VIEW_ID"

ALT_BEFORE_SNAPSHOT=$(run_muxctl list) ||
    fail "muxctl list failed before alternate pane launch"
kitty_rc launch \
    --source-window "id:$BOOT_KITTY_ID" \
    --type=tab \
    --copy-env \
    --hold \
    "$BIN_DIR/mux-layer" --new \
    >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "Kitty could not launch the alternate Mux layer"

ALT_VIEW_ID=$(wait_new_view_since "$ALT_BEFORE_SNAPSHOT")
SNAPSHOT=$(run_muxctl list)
ALT_LAYER=$(record_field "$SNAPSHOT" "$ALT_VIEW_ID" layer)
ALT_KITTY_ID=$(record_field "$SNAPSHOT" "$ALT_VIEW_ID" kitty)
reported_alt_pid=$(record_field "$SNAPSHOT" "$ALT_VIEW_ID" pid)
[[ -n $ALT_LAYER && $ALT_LAYER != main ]] ||
    fail "alternate pane did not register a distinct layer"
[[ -n $ALT_KITTY_ID ]] || fail "alternate pane did not report a Kitty window ID"
KITTY_WINDOW_IDS+=("$ALT_KITTY_ID")

for (( attempt=0; attempt < 200; attempt++ )); do
    ALT_PANE_PID=$(marked_pid mux-pane "$BOOT_PANE_PID" 2>/dev/null || true)
    if [[ -n $ALT_PANE_PID ]]; then
        break
    fi
    ALT_PANE_PID=0
    assert_core_alive
    sleep 0.05
done
(( ALT_PANE_PID > 0 )) || fail "alternate mux-pane process was not observed"
[[ $reported_alt_pid == "$ALT_PANE_PID" ]] ||
    fail "alternate muxctl PID $reported_alt_pid does not match process $ALT_PANE_PID"

run_muxctl layer "$ALT_LAYER" >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl layer failed for $ALT_LAYER"
wait_layer "$ALT_LAYER" "$ALT_VIEW_ID"

run_muxctl layer main >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl layer failed for main"
wait_layer main "$BOOT_VIEW_ID"

kitty_rc send-key --match "id:$BOOT_KITTY_ID" super+l \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 ||
    fail "encrypted Super+L injection failed for $BOOT_VIEW_ID"
wait_bar_editing "$BAR_KITTY_ID"
kitty_rc send-text --match "id:$BAR_KITTY_ID" "$BAR_URL" \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 ||
    fail "encrypted URL input failed for the global bar"
kitty_rc send-key --match "id:$BAR_KITTY_ID" enter \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 ||
    fail "encrypted Enter injection failed for the global bar"
wait_title "$BOOT_VIEW_ID" "$BAR_URL" MUX_SMOKE_BAR_LOADED
wait_frame_ack "$BOOT_KITTY_ID" "$BAR_URL" MUX_SMOKE_BAR_LOADED

run_muxctl open "$BOOT_VIEW_ID" "$SECOND_URL" >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "targeted navigation failed for $BOOT_VIEW_ID"
wait_title "$BOOT_VIEW_ID" "$SECOND_URL" MUX_SMOKE_SECOND_LOADED
wait_frame_ack "$BOOT_KITTY_ID" "$SECOND_URL" MUX_SMOKE_SECOND_LOADED

run_muxctl open "$BOOT_VIEW_ID" "$SAME_CLIPBOARD_URL" \
    >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "same-page clipboard fixture navigation failed"
wait_title "$BOOT_VIEW_ID" "$SAME_CLIPBOARD_URL" MUX_CLIP_SAME_SOURCE_READY
wait_frame_ack "$BOOT_KITTY_ID" "$SAME_CLIPBOARD_URL" MUX_CLIP_SAME_SOURCE_READY
run_muxctl focus "$BOOT_VIEW_ID" >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl focus failed before same-page copy"
wait_active_view "$BOOT_VIEW_ID"
kitty_rc send-key --match "id:$BOOT_KITTY_ID" "$LINUX_COMPAT_COPY_CHORD" \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 || fail "same-page copy injection failed"
wait_fixture_event same copy
wait_title "$BOOT_VIEW_ID" "$SAME_CLIPBOARD_URL" MUX_CLIP_SAME_COPY_PASS
wait_frame_ack "$BOOT_KITTY_ID" "$SAME_CLIPBOARD_URL" MUX_CLIP_SAME_COPY_PASS
run_muxctl open "$BOOT_VIEW_ID" "$SAME_CLIPBOARD_TARGET_URL" \
    >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "same-pane clipboard target navigation failed"
wait_title "$BOOT_VIEW_ID" "$SAME_CLIPBOARD_TARGET_URL" MUX_CLIP_SAME_TARGET_READY
wait_frame_ack "$BOOT_KITTY_ID" "$SAME_CLIPBOARD_TARGET_URL" MUX_CLIP_SAME_TARGET_READY
kitty_rc send-key --match "id:$BOOT_KITTY_ID" "$LINUX_COMPAT_PASTE_CHORD" \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 || fail "same-pane paste injection failed"
wait_fixture_event same paste
wait_title "$BOOT_VIEW_ID" "$SAME_CLIPBOARD_TARGET_URL" MUX_CLIP_SAME_PASS
wait_frame_ack "$BOOT_KITTY_ID" "$SAME_CLIPBOARD_TARGET_URL" MUX_CLIP_SAME_PASS

run_muxctl open "$BOOT_VIEW_ID" "$CROSS_PANE_SOURCE_URL" \
    >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "cross-pane clipboard source navigation failed"
wait_title "$BOOT_VIEW_ID" "$CROSS_PANE_SOURCE_URL" MUX_CLIP_CROSS_PANE_SOURCE_READY
wait_frame_ack "$BOOT_KITTY_ID" "$CROSS_PANE_SOURCE_URL" MUX_CLIP_CROSS_PANE_SOURCE_READY
kitty_rc send-key --match "id:$BOOT_KITTY_ID" "$LINUX_COMPAT_COPY_CHORD" \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 || fail "cross-pane copy injection failed"
wait_fixture_event cross-pane copy
wait_title "$BOOT_VIEW_ID" "$CROSS_PANE_SOURCE_URL" MUX_CLIP_CROSS_PANE_COPY_PASS
wait_frame_ack "$BOOT_KITTY_ID" "$CROSS_PANE_SOURCE_URL" MUX_CLIP_CROSS_PANE_COPY_PASS

run_muxctl open "$ALT_VIEW_ID" "$CROSS_PANE_TARGET_URL" \
    >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "cross-pane clipboard target navigation failed"
run_muxctl focus "$ALT_VIEW_ID" >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl focus failed before cross-pane paste"
wait_active_view "$ALT_VIEW_ID"
wait_title "$ALT_VIEW_ID" "$CROSS_PANE_TARGET_URL" MUX_CLIP_CROSS_PANE_TARGET_READY
wait_frame_ack "$ALT_KITTY_ID" "$CROSS_PANE_TARGET_URL" MUX_CLIP_CROSS_PANE_TARGET_READY
kitty_rc send-key --match "id:$ALT_KITTY_ID" "$LINUX_COMPAT_PASTE_CHORD" \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 || fail "cross-pane paste injection failed"
wait_fixture_event cross-pane paste
wait_title "$ALT_VIEW_ID" "$CROSS_PANE_TARGET_URL" MUX_CLIP_CROSS_PANE_PASS
wait_frame_ack "$ALT_KITTY_ID" "$CROSS_PANE_TARGET_URL" MUX_CLIP_CROSS_PANE_PASS

run_muxctl open "$BOOT_VIEW_ID" "$CROSS_PROFILE_SOURCE_URL" \
    >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "cross-profile clipboard source navigation failed"
run_muxctl focus "$BOOT_VIEW_ID" >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl focus failed before cross-profile copy"
wait_active_view "$BOOT_VIEW_ID"
wait_title "$BOOT_VIEW_ID" "$CROSS_PROFILE_SOURCE_URL" MUX_CLIP_CROSS_PROFILE_SOURCE_READY
wait_frame_ack "$BOOT_KITTY_ID" "$CROSS_PROFILE_SOURCE_URL" MUX_CLIP_CROSS_PROFILE_SOURCE_READY
kitty_rc send-key --match "id:$BOOT_KITTY_ID" "$LINUX_COMPAT_COPY_CHORD" \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 || fail "cross-profile copy injection failed"
wait_fixture_event cross-profile copy
wait_title "$BOOT_VIEW_ID" "$CROSS_PROFILE_SOURCE_URL" MUX_CLIP_CROSS_PROFILE_COPY_PASS
wait_frame_ack "$BOOT_KITTY_ID" "$CROSS_PROFILE_SOURCE_URL" MUX_CLIP_CROSS_PROFILE_COPY_PASS

ISOLATED_PROFILE=runtime-smoke-private
ISOLATED_LAYER=runtime-smoke-private
ISOLATED_ENGINE_SOCKET="$XDG_RUNTIME_DIR/mux/private-engine.sock"
env \
    MUX_PROFILE="$ISOLATED_PROFILE" \
    MUX_EPHEMERAL=1 \
    MUX_ENGINE_SOCKET="$ISOLATED_ENGINE_SOCKET" \
    MUX_PROFILE_DATA_DIR="$BASE/private-profile-data" \
    MUX_PROFILE_CACHE_DIR="$BASE/private-profile-cache" \
    MUX_SMOKE_FRAME_ACK_FILE="$FRAME_ACK_TELEMETRY" \
    "$BIN_DIR/mux-engine" --profile "$ISOLATED_PROFILE" --socket "$ISOLATED_ENGINE_SOCKET" \
    >"$LOG_DIR/private-engine.log" 2>&1 &
ISOLATED_ENGINE_PID=$!
track_child "$ISOLATED_ENGINE_PID" private-mux-engine
wait_socket "$ISOLATED_ENGINE_SOCKET" "$ISOLATED_ENGINE_PID" private-mux-engine

ISOLATED_BEFORE_SNAPSHOT=$(run_muxctl list) ||
    fail "muxctl list failed before isolated pane launch"
kitty_rc launch \
    --source-window "id:$BOOT_KITTY_ID" \
    --type=tab \
    --copy-env \
    --hold \
    env \
        MUX_PROFILE="$ISOLATED_PROFILE" \
        MUX_EPHEMERAL=1 \
        MUX_LAYER="$ISOLATED_LAYER" \
        MUX_GLOBAL_BAR=0 \
        MUX_ENGINE_SOCKET="$ISOLATED_ENGINE_SOCKET" \
        MUX_PROFILE_DATA_DIR="$BASE/private-profile-data" \
        MUX_PROFILE_CACHE_DIR="$BASE/private-profile-cache" \
        "$BIN_DIR/mux-pane" "$PASSIVE_READ_URL" \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 ||
    fail "Kitty could not launch the isolated-profile pane"

ISOLATED_VIEW_ID=$(wait_new_view_since "$ISOLATED_BEFORE_SNAPSHOT" "$PASSIVE_READ_URL")
SNAPSHOT=$(run_muxctl list)
ISOLATED_KITTY_ID=$(record_field "$SNAPSHOT" "$ISOLATED_VIEW_ID" kitty)
ISOLATED_PANE_PID=$(record_field "$SNAPSHOT" "$ISOLATED_VIEW_ID" pid)
[[ -n $ISOLATED_KITTY_ID ]] || fail "isolated pane did not report a Kitty window ID"
[[ $ISOLATED_PANE_PID =~ ^[1-9][0-9]*$ ]] || fail "isolated pane did not report a PID"
KITTY_WINDOW_IDS+=("$ISOLATED_KITTY_ID")
wait_active_view "$ISOLATED_VIEW_ID"
wait_fixture_event passive-read read
privacy_mode=$(fixture_record_field "$FIXTURE_EVENT_RECORD" mode)
case $privacy_mode in
    rejected) privacy_title=MUX_CLIP_PRIVACY_BLOCKED ;;
    unavailable) privacy_title=MUX_CLIP_PRIVACY_UNAVAILABLE ;;
    *) fail "unexpected passive clipboard read result: $FIXTURE_EVENT_RECORD" ;;
esac
wait_title "$ISOLATED_VIEW_ID" "$PASSIVE_READ_URL" "$privacy_title"
wait_frame_ack "$ISOLATED_KITTY_ID" "$PASSIVE_READ_URL" "$privacy_title"
qualify_private_history_absence "$ISOLATED_KITTY_ID"

run_muxctl open "$ISOLATED_VIEW_ID" "$CROSS_PROFILE_TARGET_URL" \
    >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "cross-profile clipboard target navigation failed"
wait_title "$ISOLATED_VIEW_ID" "$CROSS_PROFILE_TARGET_URL" MUX_CLIP_CROSS_PROFILE_TARGET_READY
wait_frame_ack "$ISOLATED_KITTY_ID" "$CROSS_PROFILE_TARGET_URL" MUX_CLIP_CROSS_PROFILE_TARGET_READY
kitty_rc send-key --match "id:$ISOLATED_KITTY_ID" "$LINUX_COMPAT_PASTE_CHORD" \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 || fail "cross-profile paste injection failed"
wait_fixture_event cross-profile paste
wait_title "$ISOLATED_VIEW_ID" "$CROSS_PROFILE_TARGET_URL" MUX_CLIP_CROSS_PROFILE_PASS
wait_frame_ack "$ISOLATED_KITTY_ID" "$CROSS_PROFILE_TARGET_URL" MUX_CLIP_CROSS_PROFILE_PASS

kitty_rc send-key --match "id:$ISOLATED_KITTY_ID" super+q \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 ||
    fail "encrypted Super+Q injection failed for $ISOLATED_VIEW_ID"
wait_view_closed "$ISOLATED_VIEW_ID" "$ISOLATED_PANE_PID"

run_muxctl focus "$ALT_VIEW_ID" >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl focus failed for $ALT_VIEW_ID"
wait_active_view "$ALT_VIEW_ID"
kitty_rc send-key --match "id:$ALT_KITTY_ID" super+q \
    >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "encrypted Super+Q injection failed for $ALT_VIEW_ID"
wait_view_closed "$ALT_VIEW_ID" "$ALT_PANE_PID"

run_muxctl focus "$BOOT_VIEW_ID" >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl focus failed for $BOOT_VIEW_ID"
wait_active_view "$BOOT_VIEW_ID"
kitty_rc send-key --match "id:$BOOT_KITTY_ID" super+q \
    >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "encrypted Super+Q injection failed for $BOOT_VIEW_ID"
wait_view_closed "$BOOT_VIEW_ID" "$BOOT_PANE_PID"

final_status=$(run_muxctl status) || fail "muxctl status failed after pane closure"
[[ $final_status =~ (^|[[:space:]])views=0($|[[:space:]]) ]] ||
    fail "muxd retained views after graceful close: $final_status"
pid_alive "$ENGINE_PID" || fail "central engine exited after its last view closed"
pid_alive "$ISOLATED_ENGINE_PID" || fail "isolated engine exited after its last view closed"
pid_alive "$MUXD_PID" || fail "muxd exited after its last view closed"

printf 'runtime-smoke: browser path, hashed Kitty FRAME_ACK, same-page/cross-pane/cross-profile clipboard, privacy boundaries, focus, layers, navigation, and graceful close passed\n'

timeout 6s "$BIN_DIR/muxctl" stop >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl stop did not complete within its lifecycle deadline"
wait_child_reaped "$ENGINE_PID" "central profile engine"
wait_child_reaped "$ISOLATED_ENGINE_PID" "isolated profile engine"
wait_child_reaped "$MUXD_PID" muxd

teardown_children
[[ ! -S $MUX_ENGINE_SOCKET ]] || fail "engine socket remained after shutdown"
[[ ! -S $ISOLATED_ENGINE_SOCKET ]] || fail "isolated engine socket remained after shutdown"
[[ ! -S $XDG_RUNTIME_DIR/mux/muxd.sock ]] || fail "muxd socket remained after shutdown"

printf 'runtime-smoke: PASS\n'
