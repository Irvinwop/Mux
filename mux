#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)

if [ "$(uname -s)" != "Linux" ]; then
    printf '%s\n' "Mux currently runs on Linux because WPEPlatform is Linux-only." >&2
    exit 1
fi

for command in id kitty kitten meson ninja pkg-config sha256sum stat; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf '%s\n' "Missing required command: $command" >&2
        exit 1
    fi
done

require_kitty_045() {
    if ! kitty_version_output=$(LC_ALL=C kitty --version 2>/dev/null); then
        printf '%s\n' "Mux requires Kitty 0.45 or newer, but kitty --version failed." >&2
        exit 1
    fi

    case $kitty_version_output in
        "kitty "*) kitty_version=${kitty_version_output#kitty } ;;
        *)
            printf '%s\n' "Mux could not parse Kitty's version output: $kitty_version_output" >&2
            printf '%s\n' "Install Kitty 0.45 or newer." >&2
            exit 1
            ;;
    esac
    kitty_version=${kitty_version%% *}
    case $kitty_version in
        ''|*[!0-9.]*|.*|*.|*..*)
            printf '%s\n' "Mux could not parse Kitty's version output: $kitty_version_output" >&2
            printf '%s\n' "Install Kitty 0.45 or newer." >&2
            exit 1
            ;;
    esac
    case $kitty_version in
        *.*.*.*)
            printf '%s\n' "Mux could not parse Kitty's version output: $kitty_version_output" >&2
            printf '%s\n' "Install Kitty 0.45 or newer." >&2
            exit 1
            ;;
        *.*) ;;
        *)
            printf '%s\n' "Mux could not parse Kitty's version output: $kitty_version_output" >&2
            printf '%s\n' "Install Kitty 0.45 or newer." >&2
            exit 1
            ;;
    esac

    kitty_version_major=${kitty_version%%.*}
    kitty_version_remainder=${kitty_version#*.}
    kitty_version_minor=${kitty_version_remainder%%.*}
    if [ "$kitty_version_major" -eq 0 ] && [ "$kitty_version_minor" -lt 45 ]; then
        printf '%s\n' "Mux requires Kitty 0.45 or newer; found $kitty_version." >&2
        exit 1
    fi
}

require_kitty_045

if ! pkg-config --atleast-version=2.52 wpe-webkit-2.0 ||
   ! pkg-config --atleast-version=2.52 wpe-platform-2.0; then
    cat >&2 <<'EOF'
Mux needs WPE WebKit 2.52 or newer built with:

    -DENABLE_WPE_PLATFORM=ON

The required pkg-config modules are wpe-webkit-2.0 and wpe-platform-2.0.
See docs/running-wpe.md for the exact runtime boundary.
EOF
    exit 1
fi

cache_root=$(printenv XDG_CACHE_HOME 2>/dev/null || true)
if [ -z "$cache_root" ]; then
    cache_root=$HOME/.cache
fi
repo_key=$(printf '%s' "$repo_root" | sha256sum)
repo_key=${repo_key%% *}
build_dir=$cache_root/mux/checkouts/$repo_key/wpe-kitty

if [ ! -f "$build_dir/build.ninja" ]; then
    mkdir -p "$build_dir"
    meson setup \
        --buildtype=release \
        "$build_dir" \
        "$repo_root/spikes/wpe-kitty"
fi

meson compile -C "$build_dir"

PATH=$build_dir:$PATH
export PATH

if [ "$#" -gt 0 ] && [ "$1" = "ctl" ]; then
    "$build_dir/muxd" --ensure
    shift
    exec "$build_dir/muxctl" "$@"
fi

if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    printf '%s\n' "Mux needs a Wayland or X11 graphical session to launch Kitty." >&2
    printf '%s\n' "Use './mux ctl ...' for headless control commands." >&2
    exit 1
fi

MUX_LAYER=main
MUX_GLOBAL_BAR=1
uid=$(id -u)
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    runtime_parent=$XDG_RUNTIME_DIR
    case $runtime_parent in
        /*) ;;
        *)
            printf '%s\n' "XDG_RUNTIME_DIR must be an absolute path." >&2
            exit 1
            ;;
    esac
    if [ -L "$runtime_parent" ]; then
        printf '%s\n' "XDG_RUNTIME_DIR must not be a symlink: $runtime_parent" >&2
        exit 1
    fi
    if [ ! -e "$runtime_parent" ]; then
        printf '%s\n' "XDG_RUNTIME_DIR does not exist: $runtime_parent" >&2
        exit 1
    fi
    if [ ! -d "$runtime_parent" ]; then
        printf '%s\n' "XDG_RUNTIME_DIR is not a directory: $runtime_parent" >&2
        exit 1
    fi
    if ! runtime_uid=$(stat -c %u -- "$runtime_parent" 2>/dev/null); then
        printf '%s\n' "Mux could not inspect XDG_RUNTIME_DIR ownership: $runtime_parent" >&2
        exit 1
    fi
    if [ "$runtime_uid" != "$uid" ]; then
        printf '%s\n' "XDG_RUNTIME_DIR must be owned by uid $uid: $runtime_parent" >&2
        exit 1
    fi
    if ! runtime_mode=$(stat -c %a -- "$runtime_parent" 2>/dev/null); then
        printf '%s\n' "Mux could not inspect XDG_RUNTIME_DIR permissions: $runtime_parent" >&2
        exit 1
    fi
    case $runtime_mode in
        ''|*[!0-7]*)
            printf '%s\n' "Mux could not parse XDG_RUNTIME_DIR mode '$runtime_mode': $runtime_parent" >&2
            exit 1
            ;;
    esac
    if [ $((0$runtime_mode & 077)) -ne 0 ]; then
        printf '%s\n' "XDG_RUNTIME_DIR must have no group or other permission bits: $runtime_parent (mode $runtime_mode)" >&2
        exit 1
    fi
    if [ ! -w "$runtime_parent" ] || [ ! -x "$runtime_parent" ]; then
        printf '%s\n' "XDG_RUNTIME_DIR must be writable and searchable by uid $uid: $runtime_parent" >&2
        exit 1
    fi
    kitty_runtime=$runtime_parent/mux
else
    kitty_runtime=/tmp/mux-$uid
fi

umask 077
if [ -L "$kitty_runtime" ]; then
    printf '%s\n' "Refusing symlinked runtime directory: $kitty_runtime" >&2
    exit 1
fi
mkdir -p -- "$kitty_runtime"
if [ ! -d "$kitty_runtime" ] || [ -L "$kitty_runtime" ] ||
   [ "$(stat -c %u -- "$kitty_runtime")" != "$uid" ]; then
    printf '%s\n' "Mux runtime directory is not owned by the current user." >&2
    exit 1
fi
chmod 700 -- "$kitty_runtime"

kitty_socket=$kitty_runtime/kitty-$$.sock
if [ "${#kitty_socket}" -ge 100 ]; then
    printf '%s\n' "Kitty control socket path is too long: $kitty_socket" >&2
    exit 1
fi
rm -f -- "$kitty_socket"
KITTY_LISTEN_ON=unix:$kitty_socket
export MUX_LAYER MUX_GLOBAL_BAR KITTY_LISTEN_ON

"$build_dir/muxd" --ensure

cleanup_kitty_socket() {
    rm -f -- "$kitty_socket"
}
trap cleanup_kitty_socket EXIT

kitty \
    --config "$repo_root/kitty/wpe.conf" \
    --listen-on "$KITTY_LISTEN_ON" \
    --title Mux \
    "$build_dir/mux-layer" "$@"
