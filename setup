#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

deps_only=0
declare -a mux_args=()

usage() {
  cat <<'EOF'
Usage: ./setup [--deps-only] [--] [MUX_ARGUMENTS...]

Prepare a Linux checkout and launch the real WPE implementation in Kitty.

  ./setup
  ./setup https://example.com
  ./setup --deps-only

Arch Linux and Arch Linux ARM have automatic dependency installation. On
other distributions, setup checks an existing Kitty 0.45+ and WPEPlatform
2.52+ toolchain and prints actionable diagnostics without guessing package
names.
EOF
}

while (( $# )); do
  case "$1" in
    --deps-only)
      deps_only=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      mux_args+=("$@")
      break
      ;;
    *)
      mux_args+=("$@")
      break
      ;;
  esac
done

if [[ "$(uname -s)" != Linux ]]; then
  printf 'Mux v0.1 requires Linux because its WPEPlatform and local IPC paths are Linux-specific.\n' >&2
  exit 1
fi

run_root() {
  if (( EUID == 0 )); then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    printf 'setup needs root privileges for pacman, but sudo is unavailable.\n' >&2
    printf 'Install the packages listed in docs/install.md, then rerun ./setup.\n' >&2
    exit 1
  fi
}

if command -v pacman >/dev/null 2>&1; then
  printf 'Reconciling Arch Linux dependencies with a full system upgrade.\n'
  printf 'Pacman will ask for confirmation before making changes.\n'
  run_root pacman -Syu --needed \
    base-devel \
    glib2 \
    kitty \
    meson \
    ninja \
    pkgconf \
    wpewebkit \
    gst-plugins-base \
    gst-plugins-good \
    gst-plugins-bad \
    gst-plugins-ugly \
    gst-libav \
    noto-fonts
else
  printf 'No automatic package recipe is available for this distribution.\n'
  printf 'Checking the dependencies already installed on this machine...\n'
fi

"$ROOT/doctor"

if (( deps_only )); then
  printf '\nDependencies are ready. Run ./mux to build incrementally and start Mux.\n'
  exit 0
fi

exec "$ROOT/mux" "${mux_args[@]}"
