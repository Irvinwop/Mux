active_ack_after=$(frame_ack_count "$ALT_FRAME_VIEW")
ACTIVE_ACK_DELTA=$(( active_ack_after - active_ack_before ))
printf 'resource-smoke: active visible frame acknowledgements=%s budget_min=%s\n' \
    "$ACTIVE_ACK_DELTA" "$minimum_active_acks"
if (( ACTIVE_ACK_DELTA < minimum_active_acks )); then
    record_failure "active probe produced $ACTIVE_ACK_DELTA frame acknowledgements; expected at least $minimum_active_acks"
fi

run_muxctl layer main >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl could not restore the main layer"
wait_layer main "$BOOT_VIEW_ID"
printf 'resource-smoke: hidden-layer settle %ss\n' "$idle_settle_seconds"
sleep "$idle_settle_seconds"
assert_core_alive

hidden_ack_before=$(frame_ack_count "$ALT_FRAME_VIEW")
run_phase idle "$idle_seconds" "$idle_cpu_budget"
hidden_ack_after=$(frame_ack_count "$ALT_FRAME_VIEW")
HIDDEN_ACK_DELTA=$(( hidden_ack_after - hidden_ack_before ))
printf 'resource-smoke: hidden-layer frame acknowledgements=%s budget_max=%s\n' \
    "$HIDDEN_ACK_DELTA" "$maximum_hidden_acks"
if (( HIDDEN_ACK_DELTA > maximum_hidden_acks )); then
    record_failure "hidden animated layer produced $HIDDEN_ACK_DELTA frame acknowledgements; maximum is $maximum_hidden_acks"
fi

graceful_started_ns=$(date +%s%N)
run_muxctl layer "$ALT_LAYER" >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl could not focus alternate layer for cleanup"
wait_layer "$ALT_LAYER" "$ALT_VIEW_ID"
kitty_rc send-key --match "id:$ALT_KITTY_ID" super+q \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 || fail "could not close alternate pane"
wait_view_closed "$ALT_VIEW_ID" "$ALT_PANE_PID"

run_muxctl focus "$BOOT_VIEW_ID" >>"$LOG_DIR/muxctl-actions.log" 2>&1 ||
    fail "muxctl could not focus main view for cleanup"
wait_active_view "$BOOT_VIEW_ID"
kitty_rc send-key --match "id:$BOOT_KITTY_ID" super+q \
    >>"$LOG_DIR/kitty-actions.log" 2>&1 || fail "could not close main pane"
wait_view_closed "$BOOT_VIEW_ID" "$BOOT_PANE_PID"
graceful_finished_ns=$(date +%s%N)
GRACEFUL_CLEANUP_ELAPSED=$(elapsed_seconds "$graceful_started_ns" "$graceful_finished_ns")

final_status=$(run_muxctl status) || fail "muxctl status failed after pane closure"
[[ $final_status =~ (^|[[:space:]])views=0($|[[:space:]]) ]] ||
    fail "muxd retained views after graceful close: $final_status"
pid_alive "$ENGINE_PID" || fail "mux-engine exited after its last view closed"
pid_alive "$MUXD_PID" || fail "muxd exited after its last view closed"

printf 'resource-smoke: graceful cleanup=%ss budget=%ss\n' \
    "$GRACEFUL_CLEANUP_ELAPSED" "$graceful_cleanup_budget"
if float_exceeds "$GRACEFUL_CLEANUP_ELAPSED" "$graceful_cleanup_budget"; then
    record_failure "graceful cleanup took ${GRACEFUL_CLEANUP_ELAPSED}s; budget is ${graceful_cleanup_budget}s"
fi

teardown_and_audit() {
    local pid index attempt clean=0 started_ns finished_ns

    python3 "$PROBE" capture --roots "$ROOT_PIDS" --tracked "$TRACKED_PROCESSES" \
        >"$REPORT_DIR/processes-before-teardown.tsv"
    started_ns=$(date +%s%N)

    for (( index=${#CHILD_PIDS[@]} - 1; index >= 0; index-- )); do
        pid=${CHILD_PIDS[index]}
        pid_alive "$pid" && kill -TERM "$pid" 2>/dev/null || true
    done

    for (( attempt=0; attempt < process_cleanup_budget * 10; attempt++ )); do
        if python3 "$PROBE" clean --tracked "$TRACKED_PROCESSES" --quiet; then
            clean=1
            break
        fi
        sleep 0.1
    done

    finished_ns=$(date +%s%N)
    PROCESS_CLEANUP_ELAPSED=$(elapsed_seconds "$started_ns" "$finished_ns")
    printf 'resource-smoke: process cleanup=%ss budget=%ss\n' \
        "$PROCESS_CLEANUP_ELAPSED" "$process_cleanup_budget"

    if (( clean == 0 )); then
        record_failure "scoped processes survived the ${process_cleanup_budget}s cleanup budget"
        python3 "$PROBE" clean --tracked "$TRACKED_PROCESSES" \
            >"$REPORT_DIR/cleanup-survivors.tsv" 2>&1 || true
        python3 "$PROBE" signal --tracked "$TRACKED_PROCESSES" --signal KILL || true
        sleep 0.5
    fi

    for pid in "${CHILD_PIDS[@]}"; do
        wait "$pid" 2>/dev/null || true
    done

    if ! python3 "$PROBE" clean --tracked "$TRACKED_PROCESSES" --quiet; then
        record_failure "scoped processes remained after SIGKILL fallback"
        python3 "$PROBE" clean --tracked "$TRACKED_PROCESSES" \
            >"$REPORT_DIR/post-kill-survivors.tsv" 2>&1 || true
    fi

    [[ ! -S $MUX_ENGINE_SOCKET ]] || record_failure "engine socket remained after shutdown"
    [[ ! -S $XDG_RUNTIME_DIR/mux/muxd.sock ]] || record_failure "muxd socket remained after shutdown"
    [[ ! -S $KITTY_SOCKET ]] || record_failure "Kitty socket remained after shutdown"

    if python3 "$PROBE" shm-compare \
        --baseline "$SHM_BASELINE" \
        --output "$REPORT_DIR/shm-final.json" \
        --max-bytes "$shm_leak_budget_bytes" \
        --max-entries "$shm_leak_budget_entries"; then
        :
    else
        record_failure "/dev/shm did not return to its baseline"
    fi
    TEARDOWN_DONE=1
}

teardown_and_audit

{
    printf 'active_frame_ack_delta=%s\n' "$ACTIVE_ACK_DELTA"
    printf 'hidden_frame_ack_delta=%s\n' "$HIDDEN_ACK_DELTA"
    printf 'graceful_cleanup_seconds=%s\n' "$GRACEFUL_CLEANUP_ELAPSED"
    printf 'process_cleanup_seconds=%s\n' "$PROCESS_CLEANUP_ELAPSED"
    printf 'qualification_failures=%s\n' "${#QUALIFICATION_FAILURES[@]}"
    for failure in "${QUALIFICATION_FAILURES[@]}"; do
        printf 'failure=%s\n' "$failure"
    done
} >"$REPORT_DIR/summary.txt"

if (( ${#QUALIFICATION_FAILURES[@]} > 0 )); then
    printf 'resource-smoke: FAIL (%s qualification failures)\n' \
        "${#QUALIFICATION_FAILURES[@]}" >&2
    exit 1
fi

printf 'resource-smoke: PASS\n'
